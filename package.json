{
  "name": "@cpangular/ng-material-theme-workspace",
  "version": "0.0.0-MAIN",
  "private": true,
  "description": "ng-material-theme — workspace root",
  "scripts": {
    "build": "devutil run build",
    "check": "wireit",
    "clean": "wireit",
    "fix": "wireit",
    "format": "wireit",
    "gitflow": "gitflow",
    "postinstall": "devutil dev-link auto",
    "prepare": "husky || true",
    "reset": "wireit",
    "test": "devutil run test",
    "watch": "pnpm --recursive --parallel --if-present run watch"
  },
  "devDependencies": {
    "@cpdevtools/git-flow": "^1.0.9",
    "@cpdevtools/git-flow-cli": "^1.0.9",
    "@cpdevtools/ts-dev-utilities-cli": "^1.1.6",
    "@types/node": "^20.17.11",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "syncpack": "^13.0.0",
    "typescript": "^5.9.3",
    "wireit": "^0.14.13"
  },
  "author": "cpangular",
  "license": "MIT",
  "repository": "cpangular/ng-material-theme.git",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4",
  "wireit": {
    "fix": {
      "dependencies": ["fix.syncpack", "fix.git-remove-tags", "format"]
    },
    "fix.deps": {
      "command": "devutil dep-versions fix .publish/deps.yml"
    },
    "fix.git-remove-tags": {
      "command": "git tag | xargs -r git tag -d"
    },
    "fix.syncpack": {
      "command": "syncpack fix-mismatches",
      "dependencies": ["fix.deps"]
    },
    "format": {
      "dependencies": ["format.prettier", "format.projects"]
    },
    "format.syncpack": {
      "command": "syncpack format"
    },
    "format.prettier": {
      "command": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,scss,html}\" --ignore-path .gitignore",
      "dependencies": ["format.syncpack"]
    },
    "format.projects": {
      "command": "devutil run format"
    },
    "check": {
      "dependencies": ["check.deps", "check.syncpack"]
    },
    "check.deps": {
      "command": "devutil dep-versions check .publish/deps.yml"
    },
    "check.syncpack": {
      "command": "syncpack list-mismatches"
    },
    "clean": {
      "dependencies": ["clean.install"]
    },
    "clean.git": {
      "command": "git clean -dfX",
      "cache": false
    },
    "clean.install": {
      "command": "pnpm install",
      "dependencies": ["clean.git"],
      "cache": false
    },
    "reset": {
      "dependencies": ["reset.git", "pnpm.install"]
    },
    "reset.git": {
      "command": "git reset --hard",
      "cache": false
    },
    "pnpm.install": {
      "command": "pnpm install",
      "cache": false
    }
  }
}
