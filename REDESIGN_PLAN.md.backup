Utility functions (keep existing).

```typescript
export function setTheme(name: string): void {
  document.documentElement.setAttribute('theme', name);
  localStorage.setItem('theme', name);
}

export function setThemeMode(mode: 'light' | 'dark'): void {
  document.documentElement.setAttribute('theme-mode', mode);
  localStorage.setItem('theme-mode', mode);
}

export function getActiveTheme(): string {
  return document.documentElement.getAttribute('theme') || 'default';
}

export function getActiveMode(): 'light' | 'dark' {
  return (document.documentElement.getAttribute('theme-mode') as 'light' | 'dark') || 'light';
}
```

---Hierarchical Configuration
NEW: Theme-level defaults with optional per-palette overrides:

```scss
// Set defaults at theme level
blends: (
  darker-1: 90%,
  lighter-1: 90%
),
opacities: (
  1: 10%,
  2: 20%
),
contrast-blends: (
  default: 90%
),

// Override only where needed at palette level
colors: (
  primary: (
    value: '#6200ee',
    blend-darker-1: 85%,  // override theme default
    opacity-2: 25%        // override theme default
  ),
  secondary: '#03dac6'  // uses all theme defaultsscss
@use '@cpangular/ng-material-theme' as theme;

// Include core (Material core + @property declarations)
@include theme.core();

// Define a theme with per-palette customization
@include theme.theme('custom', (
  colors: (
    primary: (
      value: '#6200ee',
      contrast: white,  // optional override
      
      // Optional per-palette blend customization
      blend-darker-1: 85%,
      blend-lighter-1: 95%,
      
      // Optional per-palette opacity customization
      opacity-2: 25%,
      opacity-5: 55%,
      
      // Optional per-palette contrast blend customization
      contrast-blend: 85%,
      contrast-blend-emphasized: 95%
    ),
    secondary: '#03dac6',  // simple form - use defaults
    tertiary: '#bb86fc',
    neutral: '#1c1b1f',
    error: '#b00020'
  ),
  typography: null,  // use Material defaults
  density: 0
), $is-default: true);

// Define additional themes
@include theme.theme('dark-theme', (
  colors: (
    primary: '#bb86fc',
    secondary: (
      value: '#03dac6',
      opacity-3: 40%  // customize just one property
    ),
    // ... other colors with per-palette configs
  )
));
```

**TypeScript runtime usage**:
```typescript
import { Component } from '@angular/core';
import { NgMaterialThemeService } from '@cpangular/ng-material-theme';

@Component({
  selector: 'app-root',
  template: `
    <button (click)="createDynamicTheme()">Create Theme</button>
  `
})
export class AppComponent {
  constructor(private themeService: NgMaterialThemeService) {}
  
  createDynamicTheme() {
    // Create theme at runtime with per-palette customization
    const themeCSS = this.themeService.createRuntimeTheme('user-theme', {
      colors: {
        primary: {
          value: '#ff5722',
          'blend-darker-1': '88%',  // custom blend for this palette
          'opacity-1': 15%,  // custom opacity
          'contrast-blend': '95%'  // custom contrast blend
        },
        secondary: '#4caf50',  // simple form - uses defaults
        tertiary: {
          value: '#2196f3',
          'opacity-5': '60%'  // only customize one property
        }
      },
      density: -1
    });
    
    // Save to database
    localStorage.setItem('user-theme-css', themeCSS);
    
    // Apply the theme
    this.themeService.setTheme('user-theme');
  }
}
```

