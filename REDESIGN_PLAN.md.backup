    nerateThemeDefaults(config: ThemeConfig): string {
  let css = '';
  
  // Blend percentages
  const blends = config.blends || {};
  css += `  --theme--blend--darker-2: ${blends['darker-2'] || '80%'};\n`;
  css += `  --theme--blend--darker-1: ${blends['darker-1'] || '90%'};\n`;
  css += `  --theme--blend--lighter-1: ${blends['lighter-1'] || '90%'};\n`;
  css += `  --theme--blend--lighter-2: ${blends['lighter-2'] || '80%'};\n`;
  
  // Opacities
  const opacities = config.opacities || {};
  const defaultOpacities = ['10%', '20%', '30%', '40%', '50%', '70%', '90%'];
  for (let i = 1; i <= 7; i++) {
    css += `  --theme--opacity--${i}: ${opacities[i as unknown as keyof typeof opacities] || defaultOpacities[i - 1]};\n`;
  }
  
  // Contrast blends
  const contrastBlends = config['contrast-blends'] || {};
  css += `  --theme--contrast-blend--emphasized: ${contrastBlends['emphasized'] || '100%'};\n`;
  css += `  --theme--contrast-blend: ${contrastBlends['default'] || '90%'};\n`;
  css += `  --theme--contrast-blend--deemphasized: ${contrastBlends['deemphasized'] || '80%'};\n`;
  css += `  --theme--contrast-blend--disabled: ${contrastBlends['disabled'] || '50%'};\n`;
  
  return css;
}

function getConfigValue(config: string | PaletteConfig, key: keyof PaletteConfig, themeDefault: string): string {
  if (typeof config === 'string') return themeDefault;
  // If palette-specific value exists, use it; otherwise fall back to theme default
  return config[key] || themeDefaultnts(paletteName);
    
